<?xml version="1.0" encoding="utf-8"?>
<!--
  Gestures, global actions (Back, Home, Recents), plus typing into the focused field on Android 13+
  (flagInputMethodEditor; ignored by older versions). No event types and no canRetrieveWindowContent: this
  service cannot read the screen.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:description="@string/duodesk_control_service_description"
  android:accessibilityFeedbackType="feedbackGeneric"
  android:accessibilityFlags="flagInputMethodEditor"
  android:canPerformGestures="true"
  android:isAccessibilityTool="false" />
