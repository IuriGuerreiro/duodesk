{
  "name": "duodesk",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:desktop": "pnpm --filter @duodesk/desktop dev",
    "dev:desktop:tauri": "pnpm --filter @duodesk/desktop tauri:dev",
    "dev:mobile": "pnpm --filter @duodesk/mobile dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "dev:web": "pnpm --filter @duodesk/web dev",
    "deploy:web": "pnpm --filter @duodesk/web deploy",
    "build:desktop": "turbo run build --filter=@duodesk/desktop",
    "package:desktop": "pnpm --filter @duodesk/desktop package"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.8",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  }
}
